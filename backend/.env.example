# ══════════════════════════════════════════════
# CRYPTOGAMER — Backend Environment Variables
# Copiar a .env y completar los valores
# NUNCA commitear el archivo .env real
# ══════════════════════════════════════════════

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (SQLite para dev, PostgreSQL para prod) ──
DATABASE_URL="file:./prisma/dev.db"
# Producción con PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/cryptogamer_db"

# ── CORS ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL_2=https://tu-dominio.com  # segundo origen (opcional)

# ── JWT ───────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio_de_al_menos_64_chars
JWT_EXPIRES_IN=7d
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Cloudinary (imágenes) ─────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ─────────────────────────────────────
# Opción A: Resend (RECOMENDADO en VPS — usa HTTP, no se bloquea)
# Crear cuenta gratis en https://resend.com → API Keys → Create
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# El FROM debe ser un dominio verificado en Resend (ej: tu dominio cryptogamer.ar)
EMAIL_FROM="Cryptogamer's <noreply@cryptogamer.ar>"

# Opción B: SMTP directo (solo para dev local — Hostinger VPS bloquea estos puertos)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=tu_contraseña_de_app

# Email del admin (recibe notificaciones de nuevas órdenes)
ADMIN_EMAIL=tu@email.com

# ── MercadoPago ───────────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── Superadmin ────────────────────────────────
SEED_SUPERADMIN_PASS=CambiameEnProduccion!

# ── Rate Limiting (opcional override) ─────────
# RATE_LIMIT_WINDOW_MS=900000   # 15 min
# RATE_LIMIT_MAX_REQUESTS=100
